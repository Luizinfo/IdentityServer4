<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <PackageId>ZinfoFramework.IdentityServer4</PackageId>
    <Version>10.0.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <Description>ZinfoFramework independent continuation of the IdentityServer4 OpenID Connect and OAuth 2.0 framework for ASP.NET Core.</Description>
    <Authors>Luiz Antonio</Authors>
    <Copyright>Copyright (c) 2026 Luiz Antonio and IdentityServer4 contributors</Copyright>
    <AssemblyName>IdentityServer4</AssemblyName>
    <PackageTags>ZinfoFramework;OAuth2;OAuth 2.0;OpenID Connect;Security;Identity;IdentityServer</PackageTags>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageProjectUrl>https://github.com/Luizinfo/IdentityServer4</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Luizinfo/IdentityServer4.git</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>ZinfoFramework 10.0.0 is an independently maintained .NET 10 continuation. See https://github.com/Luizinfo/IdentityServer4/releases.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Declare that the Repository URL can be published to NuSpec -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Embed source files that are not tracked by the source control manager to the PDB -->
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Include PDB in the built .nupkg -->
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <!-- strong naming fml -->
    <AssemblyOriginatorKeyFile>../../../key.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true'">True</ContinuousIntegrationBuild>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">True</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="../../../icon.jpg" Pack="true" Visible="false" PackagePath="" />
    <None Include="../../../README.md" Pack="true" PackagePath="" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../../ATTRIBUTION.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZinfoFramework.IdentityServer4.Storage" />
    <PackageReference Include="ZinfoFramework.IdentityModel" />

    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />

    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>
</Project>
