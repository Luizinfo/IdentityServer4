<Project>

    <PropertyGroup>
        <AspNetVersion>10.0.0</AspNetVersion>
        <IdentityServerVersion>10.0.0</IdentityServerVersion>
        <RazorLangVersion>Latest</RazorLangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Update="ZinfoFramework.IdentityModel" Version="10.0.0" />
        <PackageReference Update="ZinfoFramework.IdentityServer4" Version="$(IdentityServerVersion)" />
        <PackageReference Update="ZinfoFramework.IdentityServer4.EntityFramework" Version="$(IdentityServerVersion)" />
        <PackageReference Update="ZinfoFramework.IdentityServer4.AspNetIdentity" Version="$(IdentityServerVersion)" />

        <PackageReference Update="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Authentication.Google" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.AspNetCore.Identity.UI" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.SqlServer" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Sqlite" Version="$(AspNetVersion)" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Tools" Version="$(AspNetVersion)" PrivateAssets="All" />
        <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="$(AspNetVersion)" />

        <PackageReference Update="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />

        <PackageReference Update="Serilog.AspNetCore" Version="10.0.0" />
    </ItemGroup>
</Project>
